# Line endings - keep cross-platform files consistent.
#
# Windows Git defaults (autocrlf=true) convert files to CRLF on checkout.
# This creates noisy diffs when the repository is edited on multiple systems.

* text=auto eol=lf

# Windows scripts remain CRLF, as expected by PowerShell.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binaries: do not modify line endings.
*.png   binary
*.jpg   binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.woff  binary
*.woff2 binary
*.zip   binary
