# --- Environment ---
ENVIRONMENT=dev              # dev | test | production
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rag:ragpass@localhost:5432/ragdb

# --- Security ---
# Production: openssl rand -hex 32
JWT_SECRET=dev-only-change-me
JWT_TTL_MINUTES=15
REDACT_PII=true

# --- Model provider ---
# ollama = local models · stub = deterministic provider for tests and CI (see ADR 0009)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PORT=11434
GENERATION_MODEL=qwen2.5:7b-instruct
UTILITY_MODEL=qwen2.5:3b-instruct
JUDGE_MODEL=qwen2.5:3b-instruct
LLM_MAX_CONCURRENCY=2
LLM_TIMEOUT_SECONDS=120
DAILY_TOKEN_QUOTA=200000

# --- Embeddings ---
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDINGS_ENABLED=true

# --- Retrieval ---
RETRIEVAL_CANDIDATES=30
RETRIEVAL_TOP_K=5
RRF_K=60
HYBRID_ENABLED=true
RERANK_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MULTI_QUERY_ENABLED=true

# --- Refusal thresholds ---
MIN_RERANK_SCORE=0.25
MIN_GROUNDEDNESS=0.6
MAX_CONTEXT_TOKENS=3000

# --- Agent limits ---
MAX_TOOL_CALLS=6
MAX_WALL_CLOCK_SECONDS=45

# --- Approval gates ---
# Hard ceiling: amounts above it always require a committee, regardless of retrieval.
APPROVAL_HARD_CEILING=15000
APPROVAL_POLICY_DOC=FIN-001

# --- Server ---
API_PORT=8000
